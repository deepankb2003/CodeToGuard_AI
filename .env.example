# Hugging Face API token used by every LLM-triage/review call (security triage, RAG quality review).
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# GitHub personal access token (repo scope) used to fetch PR diffs and post review comments.
GITHUB_TOKEN=
# Shared secret configured on the GitHub webhook; leave blank to skip signature checks locally.
GITHUB_WEBHOOK_SECRET=

# Postgres connection string for persisted review history.
DATABASE_URL=postgresql://codeguardian:codeguardian@localhost:5432/codeguardian

# Local directory where the Chroma vector store for the coding-standards RAG index is persisted.
CHROMA_PERSIST_DIR=.chroma
CODING_STANDARDS_PATH=docs/coding_standards.md

ENV=development
LOG_LEVEL=INFO
